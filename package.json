{
  "name": "kabira-school",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate:remote": "npx wrangler d1 execute kabira-admissions --remote --file=./drizzle/0000_glorious_karnak.sql",
    "deploy": "npm run build && npx wrangler deploy",
    "test": "node --test tests/admissions.test.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "wrangler@4.131.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
